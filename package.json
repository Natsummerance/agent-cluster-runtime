{
  "name": "@doai/workbench",
  "version": "1.0.0-alpha.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.17.0"
  },
  "scripts": {
    "doai": "tsx packages/cli/src/bin.ts",
    "test:agent": "pnpm --filter @doai/agent-runtime test",
    "test:organization": "pnpm --filter @doai/organization-bridge test",
    "test:presets": "pnpm --filter @doai/presets test",
    "test:enterprise": "pnpm --filter @doai/enterprise-plugins test",
    "test:cli": "pnpm --filter @doai/cli test",
    "typecheck:agent": "pnpm --filter @doai/agent-runtime typecheck",
    "typecheck:organization": "pnpm --filter @doai/organization-bridge typecheck",
    "typecheck:presets": "pnpm --filter @doai/presets typecheck",
    "typecheck:enterprise": "pnpm --filter @doai/enterprise-plugins typecheck",
    "typecheck:cli": "pnpm --filter @doai/cli typecheck",
    "test:host": "pnpm --filter @doai/host test",
    "typecheck:host": "pnpm --filter @doai/host typecheck"
  },
  "devDependencies": {
    "@types/node": "22.17.2",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
